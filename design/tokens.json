{
  "$comment": "Folio design tokens. Source of truth: the Folio design canvas. Units are points (1 CSS px in the design = 1 pt in SwiftUI).",
  "themes": {
    "paper": {
      "background": "#F6F1E7", "sidebar": "#EEE7D8", "sidebarBorder": "#E1D8C6",
      "surface": "#FBF8F2", "surfaceSunken": "#EFE8DA", "coverGround": "#F3ECDF", "wash": "#F1EADC",
      "ink": "#23201B", "ink2": "#5A554C", "ink3": "#6E685E", "inkOnWash": "#3E3A33",
      "rule": "#E3DACA", "control": "#D6CCB8", "controlSoft": "#E0D6C3", "navActive": "#E3D9C5",
      "grainOpacity": 0.9
    },
    "sage": { "background": "#EEF0E3", "ink": "#1F231B", "ink2": "#525A48", "ink3": "#636B58", "rule": "#D8DDC8", "grainOpacity": 0.8, "wash": "wc-sage" },
    "mist": { "background": "#ECEFF1", "ink": "#1C2229", "ink2": "#4F5861", "ink3": "#5E6771", "rule": "#D5DCE2", "grainOpacity": 0.7, "wash": "wc-lapis" },
    "dusk": { "background": "#1F1D1A", "ink": "#E9E2D4", "ink2": "#B8AF9F", "ink3": "#A39A8A", "rule": "#3A3630", "grainOpacity": 0, "wash": "wc-plum", "washBlend": "screen", "washOpacity": 0.35 }
  },
  "accents": {
    "ink":      { "value": "#34507A", "hover": "#243B5C", "default": true },
    "moss":     { "value": "#4F6339" },
    "plum":     { "value": "#66486F" },
    "graphite": { "value": "#3B3935" }
  },
  "primaryButton": { "background": "#23201B", "foreground": "#F6F1E7" },
  "highlight": { "fill": "rgba(88,122,168,0.24)", "coverage": "14%–90% of line height (marker look)" },
  "trafficLights": { "$comment": "Drawn in the mockups only to show window placement. Use the real system buttons (hidden title bar). Never draw them." },
  "type": {
    "families": {
      "display": { "default": "Newsreader", "options": ["Newsreader", "Instrument Serif", "EB Garamond", "Geist"] },
      "reading": { "default": "Literata", "options": ["Literata", "Source Serif 4", "Newsreader", "Atkinson Hyperlegible"] },
      "ui":      { "default": "Geist", "options": ["Geist", "Manrope", "DM Sans"] }
    },
    "scale": {
      "wordmarkHero": { "family": "display", "size": 64, "italic": true, "tracking": -0.02 },
      "screenTitle":  { "family": "display", "size": 40, "lineHeight": 1.05, "tracking": -0.015 },
      "greeting":     { "family": "display", "size": 44, "lineHeight": 1.05, "tracking": -0.015 },
      "editionEnd":   { "family": "display", "size": 48, "lineHeight": 1.05, "tracking": -0.02 },
      "briefTitle":   { "family": "display", "size": 42, "lineHeight": 1.08, "tracking": -0.02 },
      "cardTitle":    { "family": "display", "size": 27, "lineHeight": 1.15, "tracking": -0.01 },
      "wordmark":     { "family": "display", "size": 28, "italic": true },
      "readingBody":  { "family": "reading", "size": 20, "lineHeight": 1.66, "paragraphGap": 18, "indent": "1.4em", "userAdjustable": "16–24" },
      "briefBody":    { "family": "reading", "size": 19, "lineHeight": 1.6, "paragraphGap": 16 },
      "quote":        { "family": "reading", "size": 19, "lineHeight": 1.45, "italic": true },
      "runningHead":  { "family": "display", "size": 15, "italic": true, "color": "ink3" },
      "body":         { "family": "ui", "size": 15 },
      "control":      { "family": "ui", "size": 14, "weight": 500 },
      "meta":         { "family": "ui", "size": 13, "color": "ink2" },
      "kicker":       { "family": "ui", "size": 12, "weight": 500, "uppercase": true, "tracking": 0.06, "color": "ink2" },
      "footer":       { "family": "ui", "size": 12, "color": "ink3" }
    }
  },
  "radius": { "chip": 999, "control": 10, "nav": 8, "tile": 10, "card": 16, "popover": 16, "window": 12 },
  "spacing": { "sidebarWidth": 232, "contentPaddingTop": 64, "contentPaddingX": 64, "sectionGap": 34, "cardPadding": 24, "rowMinHeight": 54, "hitTarget": 44 },
  "reader": { "measure": 620, "columnX": 330, "textTop": 124, "chromeHeight": 72, "pageTurnZoneWidth": 260 },
  "shadow": { "popover": "0 1px 2px rgba(60,48,30,0.06), 0 18px 48px -12px rgba(60,48,30,0.22)" },
  "watercolor": {
    "files": ["wc-lapis", "wc-sage", "wc-ochre", "wc-rose", "wc-plum"],
    "blend": "multiply", "typicalOpacity": "0.5–0.9",
    "grain": { "file": "grain", "tile": 320 }
  },
  "window": { "default": [1280, 800], "min": [1040, 680] }
}
